{
  "name": "@tandiko/ui",
  "version": "0.1.0",
  "description": "tandiko component library — themeable React atoms styled entirely from --tandiko-* CSS custom properties",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tandiko/tandiko-design.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/tandiko/tandiko-design/tree/main/packages/ui#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage && node bundle-check/run.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@tandiko/icons": "workspace:*"
  },
  "peerDependencies": {
    "@tandiko/tokens": "workspace:^",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tandiko/tokens": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "playwright": "1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.2.2"
  }
}
