{
  "name": "@vipengele/react-ui",
  "version": "0.1.1",
  "description": "vipengele component library — themeable React atoms styled entirely from --vpg-* CSS custom properties",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipengele/react.git",
    "directory": "source/react-ui/packages/ui"
  },
  "homepage": "https://vipengele.github.io/react/react-ui/",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage && node bundle-check/run.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@vipengele/react-icons": "workspace:*"
  },
  "peerDependencies": {
    "@vipengele/react-tokens": "workspace:^",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@vipengele/react-tokens": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "playwright": "1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.2.2"
  }
}
