{
  "name": "@vipengele/brand",
  "version": "0.1.0",
  "private": true,
  "description": "vipengele brand kit — logo/mark/wordmark SVG vectors (text source + outlined dist), brand fonts, the brand guide, and the on-demand PNG rasterizer",
  "license": "MIT AND OFL-1.1",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipengele/react.git",
    "directory": "source/react-ui/packages/brand"
  },
  "homepage": "https://github.com/vipengele/react/tree/main/source/react-ui/packages/brand#readme",
  "bin": {
    "vipengele-brand-png": "assets/tools/build-png.js"
  },
  "exports": {
    "./svg/*": "./assets/dist/*",
    "./svg-src/*": "./assets/src/*",
    "./fonts/*": "./assets/fonts/*",
    "./guide.html": "./guide.html",
    "./guide.css": "./guide.css",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "guide.html",
    "guide.css",
    "README.md"
  ],
  "scripts": {
    "build": "node assets/tools/build-svg.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "opentype.js": "^2.0.0"
  }
}
