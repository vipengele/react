{
  "name": "@vipengele/react",
  "version": "0.3.0",
  "description": "vipengele for React — one provider that mounts the design system's theme, locale and telemetry scope",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipengele/react.git",
    "directory": "source/react-ui/packages/react"
  },
  "homepage": "https://vipengele.github.io/react/react-ui/",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@vipengele/ts": "^0.2.1"
  },
  "peerDependencies": {
    "@vipengele/react-telemetry": "workspace:^",
    "@vipengele/react-tokens": "workspace:^",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@vipengele/react-telemetry": "workspace:*",
    "@vipengele/react-tokens": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1"
  }
}
