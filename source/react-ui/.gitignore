# Build artifacts (tandiko design system)
dist/
.turbo/
storybook-static/
packages/*/generated/
ds-bundle/

# @tandiko/brand ships its outlined vectors from assets/dist/ — committed source,
# regenerated by `pnpm --filter @tandiko/brand build`. Override the generic dist/
# ignore above, but keep on-demand PNG rasters (from tandiko-brand-png) out of git.
!packages/brand/assets/dist/
!packages/brand/assets/dist/**
packages/brand/assets/dist/*.png
