# Build artifacts (vipengele design system)
dist/
.turbo/
storybook-static/
packages/*/generated/
ds-bundle/

# @vipengele/brand ships its outlined vectors from assets/dist/ — committed source,
# regenerated by `pnpm --filter @vipengele/brand build`. Override the generic dist/
# ignore above, but keep on-demand PNG rasters (from vipengele-brand-png) out of git.
!packages/brand/assets/dist/
!packages/brand/assets/dist/**
packages/brand/assets/dist/*.png

# Generated by tests and tooling. The project carries these itself because Biome
# reads the .gitignore beside its config, not the repository root's.
coverage/
node_modules/
*.tsbuildinfo
.vitest/
