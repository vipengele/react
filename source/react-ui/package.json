{
  "name": "react-ui",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "lint": "biome lint . --error-on-warnings && node ../../scripts/coverage-ignores.mjs reasons",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build:pages": "pnpm build && rm -rf pages-dist && cp -R apps/storybook/storybook-static pages-dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.3",
    "tsup": "8.5.1",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
